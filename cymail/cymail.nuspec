  <metadata>
    <id>cymail</id>
    <version>0.7.1</version>
    <packageSourceUrl>https://github.com/cybrium-ai/chocolatey-packages/tree/main/cymail</packageSourceUrl>
    <owners>Cybrium Inc</owners>
    <title>cymail - Cybrium Email Security Scanner</title>
    <authors>Cybrium Inc</authors>
    <projectUrl>https://github.com/cybrium-ai/cymail</projectUrl>
    <iconUrl>https://cybriumstorage.blob.core.windows.net/whitepapers/deck/logo_only.svg</iconUrl>
