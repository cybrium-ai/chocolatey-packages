  <metadata>
    <id>cysense</id>
    <version>0.2.3</version>
    <packageSourceUrl>https://github.com/cybrium-ai/chocolatey-packages/tree/main/cysense</packageSourceUrl>
    <owners>Cybrium Inc</owners>
    <title>cysense - Cybrium Passive Network Sensor</title>
    <authors>Cybrium Inc</authors>
    <projectUrl>https://github.com/cybrium-ai/cysense</projectUrl>
