<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>cyweb</id>
    <version>0.12.1</version>
    <packageSourceUrl>https://github.com/cybrium-ai/chocolatey-packages/tree/main/cyweb</packageSourceUrl>
    <owners>Cybrium Inc</owners>
    <title>cyweb - Cybrium Web Vulnerability Scanner</title>
    <authors>Cybrium Inc</authors>
    <projectUrl>https://github.com/cybrium-ai/cyweb</projectUrl>
    <iconUrl>https://cybriumstorage.blob.core.windows.net/whitepapers/deck/logo_only.svg</iconUrl>
    <licenseUrl>https://github.com/cybrium-ai/cyweb/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <docsUrl>https://docs.cybrium.ai/cyweb/install</docsUrl>
    <bugTrackerUrl>https://github.com/cybrium-ai/cyweb/issues</bugTrackerUrl>
    <tags>cyweb cybrium security cli rust cross-platform admin</tags>
    <summary>Fast Rust web vulnerability scanner with SARIF output</summary>
    <description>Fast web vulnerability scanner built in Rust. Scans headers, paths, server configurations, and known vulnerabilities using YAML rules, with CVE detection, baseline diffing, and SARIF output for CI/CD integration.

The Windows binary is Authenticode-signed by Cybrium Inc via Azure Trusted Signing. The install script downloads the release binary from GitHub, verifies its SHA-256 checksum, and refuses to install if the Authenticode signature is not valid. Verify after install with:

    Get-AuthenticodeSignature (Get-Command cyweb).Source
</description>
    <releaseNotes>https://github.com/cybrium-ai/cyweb/releases/tag/v0.12.1</releaseNotes>
  </metadata>
  <files>
    <file src="tools/**" target="tools" />
  </files>
</package>
